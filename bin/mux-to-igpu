#!/bin/sh
# Move the internal panel back to the Intel iGPU and restart Plasma on it.
# Detaches for the same reason as to-dgpu.sh.
# --- portable paths (bundle) ----------------------------------------------
# Resolve everything relative to this script so it works wherever it is
# unpacked. $0 is not
# reliable after the setsid re-exec, so the absolute path is resolved once here
# and passed through the environment as MUX_SELF.
if [ -z "${MUX_SELF:-}" ]; then
    MUX_SELF="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")"
fi
BINDIR=$(dirname -- "$MUX_SELF")
ROOTDIR=$(CDPATH= cd -- "$BINDIR/.." && pwd)
DIR="$ROOTDIR/kernel"
# Fall back to an installed module if this is not a source checkout.
[ -f "$DIR/nvmuxk.ko" ] || DIR="/lib/modules/$(uname -r)/updates"
LOGDIR="${MUX_LOG_DIR:-/var/log/predator-mux}"
mkdir -p "$LOGDIR" 2>/dev/null || LOGDIR=/tmp
LCD='\_SB.PC00.RP09.PXSX.LCD0'
C0=/sys/class/drm/card0-eDP-2
C1=/sys/class/drm/card1-eDP-1
[ "$(id -u)" = 0 ] || { echo "need root: sudo sh $0"; exit 1; }

if [ "${CHILD:-0}" != 1 ]; then
    LOGF="$LOGDIR/to-igpu-$(date +%Y%m%d-%H%M%S).log"
    echo "switching back to the Intel iGPU. Plasma restarts on it (~15s)."
    echo "log: $LOGF"
    CHILD=1 LOGF="$LOGF" MUX_SELF="$MUX_SELF" setsid nohup sh "$MUX_SELF" >/dev/null 2>&1 </dev/null &
    sleep 1; exit 0
fi

log() { echo "$@" >> "$LOGF"; sync; }
state() { printf '%s' "$LCD.MXDS 0x0" > /proc/acpi/call 2>/dev/null; tr -d '\000' < /proc/acpi/call; }

log "=== to-igpu $(date -Is) ==="
log "before: MXDS=$(state) eDP-1=$(cat $C1/status) eDP-2=$(cat $C0/status)"
N=$(dmesg | wc -l)

systemctl stop plasmalogin; sleep 3

rmmod nvmuxk 2>/dev/null
if insmod "$DIR/nvmuxk.ko" 2>/dev/null; then
    echo igpu > /proc/nvmuxk 2>/dev/null
    sleep 2
    dmesg | tail -n +$((N+1)) | grep -iE "nvmuxk|NVRM" | tail -12 >> "$LOGF"; sync
    rmmod nvmuxk 2>/dev/null
else
    log "insmod failed - using ACPI fallback only"
fi

printf '%s' "$LCD.MXDS 0x01" > /proc/acpi/call 2>/dev/null   # ACPI fallback
echo detect > $C1/status 2>/dev/null
echo detect > $C0/status 2>/dev/null
sleep 2
log "after: MXDS=$(state) eDP-1=$(cat $C1/status) eDP-2=$(cat $C0/status)"

# drop the NVIDIA-primary override before going back to Intel
rm -f /etc/systemd/system/plasmalogin.service.d/99-nvmux.conf
rmdir /etc/systemd/system/plasmalogin.service.d 2>/dev/null
systemctl daemon-reload
log "KWIN_DRM_DEVICES override removed (back to KWin's own GPU sort)"

systemctl start plasmalogin
log "plasma restarted on iGPU"
log "=== done $(date -Is) ==="
