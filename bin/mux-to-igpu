#!/bin/sh
# Move the internal panel back to the Intel iGPU and restart Plasma on it.
# Detaches for the same reason as to-dgpu.sh.
# --- portable paths (bundle) ----------------------------------------------
# Resolve everything relative to this script so it works wherever it is
# unpacked. $0 is not
# reliable after the setsid re-exec, so the absolute path is resolved once here
# and passed through the environment as MUX_SELF.
if [ -z "${MUX_SELF:-}" ]; then
    MUX_SELF="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")"
fi
BINDIR=$(dirname -- "$MUX_SELF")
ROOTDIR=$(CDPATH= cd -- "$BINDIR/.." && pwd)
DIR="$ROOTDIR/kernel"
LOGDIR="${MUX_LOG_DIR:-/var/log/predator-mux}"
mkdir -p "$LOGDIR" 2>/dev/null || LOGDIR=/tmp
# --- discover this machine ------------------------------------------------
# See mux-switch for why none of this is a fixed path.
NV_CARD=""; IG_CARD=""
for card in /sys/class/drm/card[0-9] /sys/class/drm/card[0-9][0-9]; do
    [ -e "$card/device/vendor" ] || continue
    case "$(cat "$card/device/vendor" 2>/dev/null)" in
        0x10de) [ -n "$NV_CARD" ] || NV_CARD=$card ;;
        0x8086|0x1002) [ -n "$IG_CARD" ] || IG_CARD=$card ;;
    esac
done
[ -n "$NV_CARD" ] && [ -n "$IG_CARD" ] || {
    echo "need an NVIDIA GPU and an Intel or AMD iGPU; run mux-preflight" >&2; exit 1; }
C0=""; C1=""
for c in "$NV_CARD"-eDP-*; do [ -e "$c/status" ] && C0=$c && break; done
for c in "$IG_CARD"-eDP-*; do [ -e "$c/status" ] && C1=$c && break; done
[ -n "$C0" ] && [ -n "$C1" ] || {
    echo "the panel is not wired to both GPUs; run mux-preflight" >&2; exit 1; }
# MXDS is read for the log only. The ACPI node is the dGPU's own, and the panel
# is the display child that carries a bit-31 _ADR.
LCD=""
NV_ACPI=$(cat "$NV_CARD/device/firmware_node/path" 2>/dev/null)
if [ -n "$NV_ACPI" ]; then
    for d in /sys/bus/acpi/devices/*/; do
        dp=$(cat "$d/path" 2>/dev/null) || continue
        case "$dp" in "$NV_ACPI".*) ;; *) continue ;; esac
        a=$(printf '%d' "$(cat "$d/adr" 2>/dev/null)" 2>/dev/null) || continue
        [ $((a / 2147483648)) -eq 1 ] 2>/dev/null && { LCD=$dp; break; }
    done
fi
# INIT_MUX_DATA needs this panel's EDID ids; see mux-switch.
edid_ids() {
    for c in "$C1" "$C0"; do
        [ -r "$c/edid" ] || continue
        [ "$(wc -c < "$c/edid" 2>/dev/null)" -gt 11 ] 2>/dev/null || continue
        od -An -tx1 -j8 -N4 "$c/edid" 2>/dev/null | awk 'NF==4{
            printf "manfid=0x%s%s productid=0x%s%s", $2, $1, $4, $3 }'
        return
    done
}
MODARGS=$(edid_ids)
[ "$(id -u)" = 0 ] || { echo "need root: sudo sh $0"; exit 1; }

if [ "${CHILD:-0}" != 1 ]; then
    LOGF="$LOGDIR/to-igpu-$(date +%Y%m%d-%H%M%S).log"
    echo "switching back to the Intel iGPU. Plasma restarts on it (~15s)."
    echo "log: $LOGF"
    CHILD=1 LOGF="$LOGF" MUX_SELF="$MUX_SELF" setsid nohup sh "$MUX_SELF" >/dev/null 2>&1 </dev/null &
    sleep 1; exit 0
fi

log() { echo "$@" >> "$LOGF"; sync; }

# Loading the module: a source checkout has an uncompressed nvmuxk.ko next to
# these scripts, but a packaged install puts it in the kernel's module tree
# where it is usually compressed (nvmuxk.ko.zst under DKMS). insmod cannot read
# a compressed module and does not search the tree, so modprobe is preferred
# whenever the module is installed, and insmod is only the source-tree path.
load_nvmuxk() {
    if [ -f "$DIR/nvmuxk.ko" ]; then
        insmod "$DIR/nvmuxk.ko" $MODARGS
    else
        modprobe nvmuxk $MODARGS
    fi
}
state() { [ -n "$LCD" ] && [ -w /proc/acpi/call ] || { echo n/a; return; }
          printf '%s' "$LCD.MXDS 0x0" > /proc/acpi/call 2>/dev/null; tr -d '\000' < /proc/acpi/call; }

log "=== to-igpu $(date -Is) ==="
log "before: MXDS=$(state) $(basename $C1)=$(cat $C1/status) $(basename $C0)=$(cat $C0/status)"
N=$(dmesg | wc -l)

systemctl stop plasmalogin; sleep 3

rmmod nvmuxk 2>/dev/null
if load_nvmuxk 2>/dev/null; then
    echo igpu > /proc/nvmuxk 2>/dev/null
    sleep 2
    dmesg | tail -n +$((N+1)) | grep -iE "nvmuxk|NVRM" | tail -12 >> "$LOGF"; sync
    rmmod nvmuxk 2>/dev/null
else
    log "insmod failed - using ACPI fallback only"
fi

printf '%s' "$LCD.MXDS 0x01" > /proc/acpi/call 2>/dev/null   # ACPI fallback
echo detect > $C1/status 2>/dev/null
echo detect > $C0/status 2>/dev/null
sleep 2
log "after: MXDS=$(state) $(basename $C1)=$(cat $C1/status) $(basename $C0)=$(cat $C0/status)"

# drop the NVIDIA-primary override before going back to Intel
rm -f /etc/systemd/system/plasmalogin.service.d/99-nvmux.conf
rmdir /etc/systemd/system/plasmalogin.service.d 2>/dev/null
systemctl daemon-reload
log "KWIN_DRM_DEVICES override removed (back to KWin's own GPU sort)"

systemctl start plasmalogin
log "plasma restarted on iGPU"
log "=== done $(date -Is) ==="
