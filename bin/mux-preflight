#!/bin/sh
# mux-preflight - verify this machine can safely run the display mux switch.
#
# Run this FIRST, and after every kernel or NVIDIA driver update. It only reads
# state and issues read-only RM controls; it never switches the mux and never
# calls INIT_MUX_DATA.
#
# Why refusing matters: a failed INIT_MUX_DATA wedges GSP's mux state so that
# GET_DISP_MUX_STATUS returns NV_ERR_NOT_SUPPORTED on every display, and that
# survives unloading the module - only a reboot clears it. INIT_MUX_DATA also
# fails without the panel's real EDID manufacturer/product ids, which are
# per-panel. So this script refuses rather than guessing.
#
# Exit 0 = safe to switch. Any other exit = do not switch.

DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
KO="$DIR/kernel/nvmuxk.ko"
FAIL=0
WARN=0

say()  { printf '%s\n' "$*"; }
ok()   { printf '  \033[32mOK\033[0m    %s\n' "$*"; }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; FAIL=$((FAIL+1)); }
warn() { printf '  \033[33mWARN\033[0m  %s\n' "$*"; WARN=$((WARN+1)); }

say "predator-mux preflight"
say "======================"

# --- 1. privileges --------------------------------------------------------
say
say "[1] privileges"
if [ "$(id -u)" = 0 ]; then
    ok "running as root"
    ROOT=1
else
    warn "not root - skipping the kernel-module checks (run with sudo for the full set)"
    ROOT=0
fi

# --- 2. machine -----------------------------------------------------------
say
say "[2] machine"
VENDOR=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)
PRODUCT=$(cat /sys/class/dmi/id/product_name 2>/dev/null)
BIOS=$(cat /sys/class/dmi/id/bios_version 2>/dev/null)
say "      vendor : ${VENDOR:-unknown}"
say "      model  : ${PRODUCT:-unknown}"
say "      BIOS   : ${BIOS:-unknown}"
case "$VENDOR" in
    *Acer*|*ACER*) ok "Acer system" ;;
    *) warn "not an Acer system - this was only ever tested on Acer Predator hardware" ;;
esac

# --- 3. GPUs and panel connectors ----------------------------------------
say
say "[3] GPUs and panel connectors"
IG_CARD=""; NV_CARD=""; IG_CONN=""; NV_CONN=""
for card in /sys/class/drm/card[0-9]; do
    [ -e "$card/device/vendor" ] || continue
    v=$(cat "$card/device/vendor" 2>/dev/null)
    case "$v" in
        0x8086) IG_CARD=$card ;;
        0x10de) NV_CARD=$card ;;
    esac
done
[ -n "$IG_CARD" ] && ok "Intel GPU  : $(basename "$IG_CARD") ($(basename "$(readlink -f "$IG_CARD/device")"))" \
                  || bad "no Intel iGPU found"
[ -n "$NV_CARD" ] && ok "NVIDIA GPU : $(basename "$NV_CARD") ($(basename "$(readlink -f "$NV_CARD/device")"))" \
                  || bad "no NVIDIA dGPU found"

# the internal panel appears as an eDP connector on BOTH cards on a muxed machine
for c in "$IG_CARD"-eDP-*; do [ -e "$c/status" ] && IG_CONN=$c && break; done
for c in "$NV_CARD"-eDP-*; do [ -e "$c/status" ] && NV_CONN=$c && break; done
if [ -n "$IG_CONN" ] && [ -n "$NV_CONN" ]; then
    ok "panel is wired to both GPUs: $(basename "$IG_CONN") + $(basename "$NV_CONN")"
    say "      current: $(basename "$IG_CONN")=$(cat "$IG_CONN/status") $(basename "$NV_CONN")=$(cat "$NV_CONN/status")"
else
    bad "need an eDP connector on BOTH GPUs (found igpu='${IG_CONN:-none}' dgpu='${NV_CONN:-none}') - this machine has no display mux"
fi

# --- 4. panel EDID ids ----------------------------------------------------
# INIT_MUX_DATA fails without these. nvkms-rm.c MuxInit():
#   /* Internal mux initialization will fail without manfId/productId */
# Read as native u16 exactly like nvt_edid.c does.
say
say "[4] panel EDID identity"
EDID=""
for c in "$IG_CONN" "$NV_CONN"; do
    [ -n "$c" ] || continue
    # NB: sysfs binary attributes always stat as size 0, so [ -s ] is
    # useless here - read the file and count what actually comes back.
    if [ -r "$c/edid" ] && [ "$(wc -c < "$c/edid" 2>/dev/null)" -gt 0 ] 2>/dev/null; then
        EDID="$c/edid"; break
    fi
done
DETECTED_MANF=""; DETECTED_PROD=""
if [ -n "$EDID" ]; then
    set -- $(od -An -tx1 -j8 -N4 "$EDID" 2>/dev/null)
    if [ $# -eq 4 ]; then
        DETECTED_MANF=$(printf '0x%s%s' "$2" "$1")
        DETECTED_PROD=$(printf '0x%s%s' "$4" "$3")
        ok "panel EDID read from $(basename "$(dirname "$EDID")") ($(wc -c < "$EDID") bytes)"
        say "      manfId=$DETECTED_MANF productId=$DETECTED_PROD"
    else
        bad "could not parse EDID bytes 8..11 from $EDID"
    fi
else
    bad "no readable EDID on either eDP connector (the panel must be attached to one GPU)"
fi

# Compare against what nvmuxk.c will actually send. A mismatch means the
# compiled-in defaults are for a different panel - refuse rather than let a
# wrong INIT_MUX_DATA wedge GSP.
SRC_MANF=$(sed -n 's/^static uint manfid = \(0x[0-9A-Fa-f]*\);.*/\1/p' "$DIR/kernel/nvmuxk.c" | head -1)
SRC_PROD=$(sed -n 's/^static uint productid = \(0x[0-9A-Fa-f]*\);.*/\1/p' "$DIR/kernel/nvmuxk.c" | head -1)
if [ -n "$DETECTED_MANF" ] && [ -n "$SRC_MANF" ]; then
    dm=$(printf '%d' "$DETECTED_MANF" 2>/dev/null); sm=$(printf '%d' "$SRC_MANF" 2>/dev/null)
    dp=$(printf '%d' "$DETECTED_PROD" 2>/dev/null); sp=$(printf '%d' "$SRC_PROD" 2>/dev/null)
    if [ "$dm" = "$sm" ] && [ "$dp" = "$sp" ]; then
        ok "module defaults match this panel"
    else
        bad "module defaults are for a DIFFERENT panel (module: $SRC_MANF/$SRC_PROD, this panel: $DETECTED_MANF/$DETECTED_PROD)"
        say "        Load the module with the right values instead of the defaults:"
        say "          insmod nvmuxk.ko manfid=$DETECTED_MANF productid=$DETECTED_PROD"
        say "        A wrong INIT_MUX_DATA wedges GSP until reboot - do not skip this."
    fi
fi

# --- 5. NVIDIA driver -----------------------------------------------------
say
say "[5] NVIDIA driver"
if lsmod 2>/dev/null | grep -q '^nvidia '; then
    ok "nvidia.ko loaded ($(grep -oE '[0-9]+\.[0-9]+\.[0-9]+' /proc/driver/nvidia/version 2>/dev/null | head -1))"
else
    bad "nvidia.ko is not loaded"
fi
if lsmod 2>/dev/null | grep -q '^nvidia_modeset'; then
    ok "nvidia_modeset loaded"
else
    warn "nvidia_modeset not loaded - the dGPU cannot drive the panel without it"
fi
if [ "$ROOT" = 1 ]; then
    if grep -qw 'nvidia_get_rm_ops' /proc/kallsyms 2>/dev/null; then
        ok "nvidia_get_rm_ops is exported (kernel-privilege RM route available)"
    else
        bad "nvidia_get_rm_ops not exported by this driver build - nvmuxk cannot work"
    fi
fi

# --- 6. module ------------------------------------------------------------
say
say "[6] nvmuxk module"
if [ -f "$KO" ]; then
    ok "built: $KO"
    if [ "$ROOT" = 1 ] && command -v modinfo >/dev/null 2>&1; then
        kv=$(modinfo -F vermagic "$KO" 2>/dev/null | awk '{print $1}')
        rv=$(uname -r)
        if [ "$kv" = "$rv" ]; then
            ok "built for the running kernel ($rv)"
        else
            bad "built for kernel '$kv' but running '$rv' - rebuild with: make -C $DIR/kernel"
        fi
    fi
else
    bad "not built - run: make -C $DIR/kernel"
fi

# --- 7. live mux capability (read-only RM controls) -----------------------
say
say "[7] mux capability (read-only)"
if [ "$ROOT" = 1 ] && [ "$FAIL" = 0 ]; then
    rmmod nvmuxk 2>/dev/null
    if insmod "$KO" 2>/dev/null; then
        echo status > /proc/nvmuxk 2>/dev/null
        sleep 1
        # Do NOT use `dmesg | tail -n +N`: the kernel ring buffer drops old lines
        # between the two dmesg calls, so absolute line offsets shift and the
        # window silently comes back empty. Anchor on the module's own load
        # marker instead and keep everything after the LAST one.
        OUT=$(dmesg | grep 'nvmuxk:' | awk '/nvmuxk: loaded/{buf=""} {buf = buf $0 "\n"} END{printf "%s", buf}')
        rmmod nvmuxk 2>/dev/null

        MASK=$(printf '%s\n' "$OUT" | sed -n 's/.*muxDisplayMask \(0x[0-9a-f]*\).*/\1/p' | head -1)
        if [ -n "$MASK" ] && [ "$MASK" != "0x00000000" ]; then
            ok "GPU reports a muxed display: muxDisplayMask=$MASK"
        else
            bad "no muxed display reported (muxDisplayMask=${MASK:-none}) - this GPU/panel pair has no dynamic mux"
        fi
        if printf '%s\n' "$OUT" | grep -q 'mode=DYNAMIC(switchable)'; then
            ok "mux mode is DYNAMIC (runtime switching supported)"
            printf '%s\n' "$OUT" | grep 'EMBEDDED PANEL' | sed 's/^.*nvmuxk: */      /'
        else
            bad "mux mode is not DYNAMIC - this machine cannot switch at runtime"
            say "        Set BIOS Display Mode to a switchable/MSHybrid option, or this tool cannot help."
        fi
        if printf '%s\n' "$OUT" | grep -q 'GET_MUX_STATUS 0x56' && \
           ! printf '%s\n' "$OUT" | grep -q 'muxStatus'; then
            bad "GET_MUX_STATUS fails on every display - GSP mux state may be wedged; REBOOT before switching"
        fi
    else
        bad "insmod failed - see dmesg"
    fi
elif [ "$ROOT" != 1 ]; then
    warn "skipped (needs root)"
else
    warn "skipped because an earlier check already failed"
fi

# --- verdict --------------------------------------------------------------
say
say "======================"
if [ "$FAIL" -gt 0 ]; then
    printf '\033[31mREFUSE\033[0m  %d check(s) failed. Do NOT run mux-switch on this machine.\n' "$FAIL"
    exit 1
fi
if [ "$WARN" -gt 0 ]; then
    printf '\033[33mPASS with %d warning(s).\033[0m Read them before switching.\n' "$WARN"
    exit 0
fi
printf '\033[32mPASS\033[0m  This machine can switch the display mux.\n'
exit 0
